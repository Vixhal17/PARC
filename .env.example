# LLM Provider API Keys (At least one is required)
# 1. Groq API Key (Recommended for ultrafast inference with openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here

# 2. Mistral AI Key (Primary fallback for mistral-large-latest / mistral-small-latest)
MISTRAL_API_KEY=your_mistral_api_key_here

# 3. NVIDIA NIM Key (Optional fallback)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: Default Model Override (e.g. groq/openai/gpt-oss-120b or mistral/mistral-large-latest)
# DEFAULT_MODEL=groq/openai/gpt-oss-120b